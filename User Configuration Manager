
user_settings = {
    "theme": "dark",
    "language": "english"
}


def add_setting(settings, new_item):
    name, value = new_item
    name = name.lower()
    value = value.lower()

    if name in settings:
        return f"Setting '{name}' already exists! Cannot add a new setting with this name."

    settings.update({name: value})
    return f"Setting '{name}' added with value '{value}' successfully!"


def update_setting(settings, updated_item):
    name, value = updated_item
    name = name.lower()
    value = value.lower()

    if name not in settings:
        return f"Setting '{name}' does not exist! Cannot update a non-existing setting."

    settings.update({name: value})
    return f"Setting '{name}' updated to '{value}' successfully!"


def delete_setting(settings, setting_name):
    setting_name = setting_name.lower()

    removed_value = settings.pop(setting_name, None)

    if removed_value is not None:
        return f"Setting '{setting_name}' deleted successfully!"

    return "Setting not found!"


def view_settings(settings):
    if len(settings) == 0:
        return "No settings available."

    output = "Current User Settings:\n"

    for name, value in settings.items():
        output += "{}: {}\n".format(name.title(), value)

    return output.rstrip()
